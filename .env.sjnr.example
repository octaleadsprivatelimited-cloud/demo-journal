JOURNAL_PROFILE=sjnr
APP_NAME="Singapore Journal of Nursing Research"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lightgreen-leopard-945544.hostingersite.com
SITEMAP_BASE_URL="${APP_URL}"
APP_FORCE_HTTPS=true
APP_TIMEZONE=UTC
SEARCH_INDEXING_ENABLED=false
SJNR_INITIALIZE_ALLOWED=false
SJNR_IMPORT_ALLOWED=false

APP_PUBLIC_PATH=/home/u709299470/domains/lightgreen-leopard-945544.hostingersite.com/public_html
PUBLIC_DISK_ROOT="${APP_PUBLIC_PATH}/storage"
FILESYSTEM_DISK=public
MEDIA_DISK=public

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PERSISTENT=true
DB_PORT=3306
DB_DATABASE=u709299470_sjnr_preview
DB_USERNAME=u709299470_sjnr_preview
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
CACHE_PREFIX=sjnr
SESSION_DRIVER=database
SESSION_COOKIE=sjnr_session
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notifications@sjnrjournal.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@sjnrjournal.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15
CONTACT_NOTIFICATION_EMAIL=notifications@sjnrjournal.com
ACCOUNT_NOTIFICATION_EMAIL=notifications@sjnrjournal.com

GOOGLE_OAUTH_ENABLED=false
GOOGLE_ONLY_AUTH=false
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_ANALYTICS_HOST=sjnrjournal.com
GOOGLE_ANALYTICS_ID=
MICROSOFT_CLARITY_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

SEED_DEMO_CONTENT=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
LOCAL_ADMIN_BYPASS_ENABLED=false
LOCAL_AUTHOR_BYPASS_ENABLED=false
LOCAL_EDITOR_BYPASS_ENABLED=false
LOCAL_REVIEWER_BYPASS_ENABLED=false

WORKFLOW_MANUSCRIPT_FORMAT=SJNR-{year}-{sequence}
WORKFLOW_ARTICLE_FORMAT=SJNR-{year}-V{volume}-I{issue}-A{sequence}
