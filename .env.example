APP_NAME="octaleads Journal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://sjcjournal.com
SITEMAP_BASE_URL=https://sjcjournal.com
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_FORCE_HTTPS=false
LOCAL_ADMIN_BYPASS_ENABLED=false
LOCAL_ADMIN_NAME="Local Administrator"
LOCAL_ADMIN_EMAIL=local-admin@localhost.test
LOCAL_ADMIN_ALLOWED_REMOTE_ADDRS=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=journal
DB_USERNAME=journal
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=redis
CACHE_PREFIX=journal

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="editorial@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_NOTIFICATION_EMAIL="editorial@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080
SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=journal_

GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

MAIL_PROVIDER=smtp
MAIL_API_KEY=
NEWSLETTER_PROVIDER=database
NEWSLETTER_API_KEY=

# Google OAuth: create a Web application client in Google Cloud Console and use
# ${APP_URL}/auth/google/callback as the authorised redirect URI.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

COMMENTS_ENABLED=true
AUTHOR_REGISTRATION_ENABLED=true
REVIEWER_WORKFLOW_ENABLED=true
PDF_DOWNLOADS_ENABLED=true
NEWSLETTER_ENABLED=true

LOGIN_RATE_LIMIT=5
CONTACT_RATE_LIMIT=5
UPLOAD_MAX_KILOBYTES=20480
TRUSTED_PROXIES=*

SEED_DEMO_CONTENT=false
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

RUN_MIGRATIONS=false
VITE_APP_NAME="${APP_NAME}"
